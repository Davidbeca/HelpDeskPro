@* Estrutura comum do HelpDesk Pro: menu, barra superior, área da página e scripts partilhados. *@
<!doctype html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script>
        document.documentElement.setAttribute('data-bs-theme', localStorage.getItem('helpdesk-theme') || 'light');
    </script>
    <title>@ViewData["Title"] - HelpDesk Pro</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/core@1.0.0-beta20/dist/css/tabler.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/dist/tabler-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="antialiased">
<div class="page">
    @* Navegação principal. ActivePage identifica visualmente a secção atual. *@
    <aside class="navbar navbar-vertical navbar-expand-md navbar-dark helpdesk-sidebar" style="background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%);">
        <div class="container-fluid">
            <div class="navbar-brand navbar-brand-autodark">
                <a asp-controller="Home" asp-action="Index" class="text-white d-flex align-items-center gap-2">
                    <i class="ti ti-headset text-blue-400 text-2xl"></i>
                    <span class="font-bold text-lg">HelpDesk Pro</span>
                </a>
            </div>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar-menu" aria-controls="sidebar-menu" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="sidebar-menu">
                <ul class="navbar-nav pt-lg-3">
                    <li class="nav-item"><a class="nav-link @(Equals(ViewData["ActivePage"], "Dashboard") ? "active" : "")" asp-controller="Home" asp-action="Index"><i class="ti ti-layout-dashboard"></i><span class="nav-link-title">Dashboard</span></a></li>
                    <li class="nav-item"><a class="nav-link @(Equals(ViewData["ActivePage"], "Tickets") ? "active" : "")" asp-controller="Tickets" asp-action="Index"><i class="ti ti-ticket"></i><span class="nav-link-title">Tickets</span></a></li>
                    <li class="nav-item"><a class="nav-link @(Equals(ViewData["ActivePage"], "Users") ? "active" : "")" asp-controller="Users" asp-action="Index"><i class="ti ti-users"></i><span class="nav-link-title">Clientes e utilizadores</span></a></li>
                    <li class="nav-item"><a class="nav-link @(Equals(ViewData["ActivePage"], "Technicians") ? "active" : "")" asp-controller="Technicians" asp-action="Index"><i class="ti ti-tool"></i><span class="nav-link-title">Técnicos</span></a></li>
                    <li class="nav-item"><a class="nav-link @(Equals(ViewData["ActivePage"], "Equipment") ? "active" : "")" asp-controller="Equipment" asp-action="Index"><i class="ti ti-device-laptop"></i><span class="nav-link-title">Equipamentos</span></a></li>
                    <li class="nav-item"><a class="nav-link @(Equals(ViewData["ActivePage"], "KnowledgeBase") ? "active" : "")" asp-controller="KnowledgeBase" asp-action="Index"><i class="ti ti-book"></i><span class="nav-link-title">Base de conhecimento</span></a></li>
                    <li class="nav-item"><a class="nav-link @(Equals(ViewData["ActivePage"], "Notifications") ? "active" : "")" asp-controller="Notifications" asp-action="Index"><i class="ti ti-bell"></i><span class="nav-link-title">Notificações</span></a></li>
                    <li class="nav-item"><a class="nav-link @(Equals(ViewData["ActivePage"], "Reports") ? "active" : "")" asp-controller="Reports" asp-action="Index"><i class="ti ti-chart-bar"></i><span class="nav-link-title">Relatórios</span></a></li>
                    <li class="nav-item"><a class="nav-link @(Equals(ViewData["ActivePage"], "Settings") ? "active" : "")" asp-controller="Settings" asp-action="Index"><i class="ti ti-settings"></i><span class="nav-link-title">Definições</span></a></li>
                </ul>
            </div>
        </div>
    </aside>
    <div class="page-wrapper">
        <header class="navbar navbar-expand-md d-print-none">
            <div class="container-xl">
                <div class="navbar-nav flex-row order-md-last ms-auto align-items-center">
                    <a class="nav-link position-relative" asp-controller="Notifications" asp-action="Index" aria-label="Notificações">
                        <i class="ti ti-bell"></i>
                        @await Component.InvokeAsync("UnreadNotificationCount")
                    </a>
                    <div class="nav-item dropdown ms-3">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">@User.Identity?.Name</a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-controller="Users" asp-action="Details" asp-route-id="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value">Perfil</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Logout">Sair</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </header>
        @* RenderBody injeta aqui o conteúdo da vista específica da rota. *@
        <main class="page-body">
            <div class="container-xl">@RenderBody()</div>
        </main>
        <footer class="footer footer-transparent d-print-none">
            <div class="container-xl"><span class="text-secondary">© @DateTime.Now.Year HelpDesk Pro - Sistema de Gestão de Suporte Técnico</span></div>
        </footer>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/@@tabler/core@1.0.0-beta20/dist/js/tabler.min.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>