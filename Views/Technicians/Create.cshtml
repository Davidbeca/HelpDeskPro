@* Permite escolher qualquer utilizador ativo e promovê-lo a técnico ao guardar. *@
@model HelpDeskPro.Models.Technician
@{ ViewData["Title"] = "Associar técnico"; ViewData["ActivePage"] = "Technicians"; }
<div class="page-header"><h1 class="page-header-title">Associar técnico</h1></div><div class="card"><div class="card-body"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="UtilizadorId" class="form-label">Utilizador a associar</label><select asp-for="UtilizadorId" class="form-select" required><option value="">Selecionar utilizador</option>@foreach (var user in ViewData["Utilizadores"] as List<HelpDeskPro.Models.ApplicationUser> ?? new()) { <option value="@user.Id">@user.NomeCompleto (@user.Email) — @user.TipoConta</option> }</select><span asp-validation-for="UtilizadorId" class="text-danger"></span></div><div class="mb-3"><label asp-for="Especialidade" class="form-label"></label><input asp-for="Especialidade" class="form-control" /><span asp-validation-for="Especialidade" class="text-danger"></span></div><div class="mb-3"><label asp-for="EstadoDisponibilidade" class="form-label">Disponibilidade</label><select asp-for="EstadoDisponibilidade" class="form-select"><option>Disponível</option><option>Ocupado</option></select></div><button class="btn btn-primary" type="submit">Associar como técnico</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></form></div></div>