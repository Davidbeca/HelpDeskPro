@* Visão da equipa técnica com disponibilidade, carga atual e produtividade. *@
@model IEnumerable<HelpDeskPro.Models.Technician>
@{ ViewData["Title"] = "Técnicos"; ViewData["ActivePage"] = "Technicians"; }
<div class="page-header d-flex justify-content-between align-items-center"><div><h1 class="page-header-title">Equipa técnica</h1><p class="text-secondary">Disponibilidade, especialidade e carga de trabalho</p></div>@if (ViewData["IsAdmin"] as bool? == true) { <a asp-action="Create" class="btn btn-primary"><i class="ti ti-plus"></i> Associar técnico</a> }</div>
<div class="card"><div class="table-responsive"><table class="table table-vcenter card-table"><thead><tr><th>Técnico</th><th>Especialidade</th><th>Disponibilidade</th><th>Tickets ativos</th><th>Resolvidos</th><th></th></tr></thead><tbody>
@foreach (var technician in Model) { <tr><td><strong>@technician.Utilizador?.NomeCompleto</strong><div class="text-secondary">@technician.Utilizador?.Email</div></td><td>@technician.Especialidade</td><td><span class="badge @(technician.EstadoDisponibilidade == "Disponível" ? "bg-green-lt" : "bg-orange-lt")">@technician.EstadoDisponibilidade</span></td><td>@technician.Utilizador?.TicketsAtribuidos.Count(t => t.Estado != "Resolvido" && t.Estado != "Fechado")</td><td>@technician.TicketsResolvidos</td><td class="text-end"><a asp-action="Details" asp-route-id="@technician.Id" class="btn btn-sm btn-outline-primary" aria-label="Detalhes"><i class="ti ti-eye"></i></a>@if (ViewData["IsAdmin"] as bool? == true) { <a asp-action="Edit" asp-route-id="@technician.Id" class="btn btn-sm btn-outline-secondary" aria-label="Editar"><i class="ti ti-edit"></i></a> }</td></tr> }
@if (!Model.Any()) { <tr><td colspan="6" class="text-center text-secondary py-5">Ainda não existem técnicos registados.</td></tr> }
</tbody></table></div></div>