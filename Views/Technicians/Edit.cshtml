@* Atualiza especialidade e disponibilidade sem substituir a conta associada. *@
@model HelpDeskPro.Models.Technician
@{ ViewData["Title"] = "Editar técnico"; ViewData["ActivePage"] = "Technicians"; }
<div class="page-header"><h1 class="page-header-title">Editar técnico</h1></div><div class="card"><div class="card-body"><form asp-action="Edit" asp-route-id="@Model.Id" method="post"><input type="hidden" asp-for="Id" /><input type="hidden" asp-for="UtilizadorId" /><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label class="form-label">Técnico</label><input class="form-control" value="@Model.UtilizadorId" readonly /></div><div class="mb-3"><label asp-for="Especialidade" class="form-label"></label><input asp-for="Especialidade" class="form-control" /><span asp-validation-for="Especialidade" class="text-danger"></span></div><div class="mb-3"><label asp-for="EstadoDisponibilidade" class="form-label">Disponibilidade</label><select asp-for="EstadoDisponibilidade" class="form-select"><option>Disponível</option><option>Ocupado</option></select></div><button class="btn btn-primary" type="submit">Guardar</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></form></div></div>