@* Ficha individual com contactos, métricas e tickets atribuídos ao técnico. *@
@model HelpDeskPro.Models.Technician
@{ ViewData["Title"] = "Detalhes do técnico"; ViewData["ActivePage"] = "Technicians"; var tickets = Model.Utilizador?.TicketsAtribuidos ?? new List<HelpDeskPro.Models.Ticket>(); }
<div class="page-header d-flex justify-content-between"><div><h1 class="page-header-title">@Model.Utilizador?.NomeCompleto</h1><p class="text-secondary">@Model.Especialidade · @Model.EstadoDisponibilidade</p></div><a asp-action="Index" class="btn btn-outline-secondary">Voltar</a></div>
<div class="row row-cards mb-3"><div class="col-md-4"><div class="card"><div class="card-body"><div class="text-secondary">Email</div><strong>@Model.Utilizador?.Email</strong><div class="text-secondary mt-3">Contacto</div><strong>@Model.Utilizador?.ContactoTelefonico</strong></div></div></div><div class="col-md-4"><div class="card"><div class="card-body"><div class="text-secondary">Tickets atribuídos</div><strong>@tickets.Count</strong><div class="text-secondary mt-3">Tickets resolvidos</div><strong>@Model.TicketsResolvidos</strong></div></div></div><div class="col-md-4"><div class="card"><div class="card-body"><div class="text-secondary">Tempo médio de resolução</div><strong>@Model.TempoMedioResolucao.ToString("0.0") h</strong></div></div></div></div>
<div class="card"><div class="card-header"><h2 class="card-title">Tickets atribuídos</h2></div><div class="table-responsive"><table class="table table-vcenter card-table"><thead><tr><th>Número</th><th>Título</th><th>Estado</th><th>Prioridade</th><th></th></tr></thead><tbody>@foreach (var ticket in tickets) { <tr><td>@ticket.NumeroTicket</td><td>@ticket.Titulo</td><td>@ticket.Estado</td><td>@ticket.Prioridade</td><td><a asp-controller="Tickets" asp-action="Details" asp-route-id="@ticket.Id" class="btn btn-sm btn-outline-primary">Abrir</a></td></tr> }@if (tickets.Count == 0) { <tr><td colspan="5" class="text-center text-secondary">Sem tickets atribuídos.</td></tr> }</tbody></table></div></div>