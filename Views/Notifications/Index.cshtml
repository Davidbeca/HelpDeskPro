@* Caixa pessoal de notificações com ações POST para marcar uma ou todas como lidas. *@
@model IEnumerable<HelpDeskPro.Models.Notificacao>
@{ ViewData["Title"] = "Notificações"; ViewData["ActivePage"] = "Notifications"; }
<div class="page-header d-flex justify-content-between align-items-center"><div><h1 class="page-header-title">Notificações</h1><p class="text-secondary">@ViewData["NaoLidas"] por ler</p></div>@if ((ViewData["NaoLidas"] as int? ?? 0) > 0) { <form asp-action="MarkAllAsRead" method="post"><button class="btn btn-outline-primary"><i class="ti ti-checks"></i> Marcar todas como lidas</button></form> }</div>
<div class="list-group">@foreach (var notification in Model) { <div class="list-group-item"><div class="row align-items-center"><div class="col-auto"><span class="status-dot @(notification.Lida ? "bg-secondary" : "bg-blue")"></span></div><div class="col text-truncate"><a href="@(notification.Url ?? "#")" class="text-body d-block">@notification.Titulo</a><div class="d-block text-secondary text-truncate mt-n1">@notification.Mensagem</div><small class="text-secondary">@notification.DataCriacao.ToString("dd/MM/yyyy HH:mm")</small></div>@if (!notification.Lida) { <div class="col-auto"><form asp-action="MarkAsRead" asp-route-id="@notification.Id" method="post"><button class="btn btn-sm btn-outline-secondary">Marcar como lida</button></form></div> }</div></div> }@if (!Model.Any()) { <div class="list-group-item text-center text-secondary py-5">Não existem notificações.</div> }</div>