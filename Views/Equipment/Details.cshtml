@* Ficha do equipamento: identifica cliente, características, estado e tickets associados. *@
@model HelpDeskPro.Models.Equipment
@{ ViewData["Title"] = Model.Nome; ViewData["ActivePage"] = "Equipment"; }
<div class="page-header d-flex justify-content-between"><div><h1 class="page-header-title">@Model.Nome</h1><p class="text-secondary">@Model.Marca @Model.Modelo · @Model.Categoria</p></div><a asp-action="Index" class="btn btn-outline-secondary">Voltar</a></div>
<div class="card mb-3"><div class="card-body"><dl class="row mb-0"><dt class="col-sm-3">Número de série</dt><dd class="col-sm-9">@Model.NumeroSerie</dd><dt class="col-sm-3">Sistema operativo</dt><dd class="col-sm-9">@Model.SistemaOperativo</dd><dt class="col-sm-3">Cliente</dt><dd class="col-sm-9">@Model.Cliente?.NomeCompleto (@Model.Cliente?.Email)</dd><dt class="col-sm-3">Estado</dt><dd class="col-sm-9">@Model.Estado</dd><dt class="col-sm-3">Registado</dt><dd class="col-sm-9">@Model.DataRegisto.ToString("dd/MM/yyyy")</dd></dl></div></div>
<div class="card"><div class="card-header"><h2 class="card-title">Tickets relacionados</h2></div><div class="table-responsive"><table class="table table-vcenter card-table"><thead><tr><th>Número</th><th>Título</th><th>Estado</th><th></th></tr></thead><tbody>@foreach (var ticket in Model.TicketsRelacionados) { <tr><td>@ticket.NumeroTicket</td><td>@ticket.Titulo</td><td>@ticket.Estado</td><td><a asp-controller="Tickets" asp-action="Details" asp-route-id="@ticket.Id">Abrir</a></td></tr> }@if (!Model.TicketsRelacionados.Any()) { <tr><td colspan="4" class="text-center text-secondary">Sem tickets relacionados.</td></tr> }</tbody></table></div></div>