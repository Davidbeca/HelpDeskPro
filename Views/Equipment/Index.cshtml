@* Inventário com filtros por texto/categoria/estado e ações adaptadas ao tipo de conta. *@
@model IEnumerable<HelpDeskPro.Models.Equipment>
@{ ViewData["Title"] = "Equipamentos"; ViewData["ActivePage"] = "Equipment"; }
<div class="page-header d-flex justify-content-between align-items-center"><div><h1 class="page-header-title">Equipamentos</h1><p class="text-secondary">Inventário ligado a clientes e tickets</p></div>@if (ViewData["IsCliente"] as bool? != true) { <a asp-action="Create" class="btn btn-primary"><i class="ti ti-plus"></i> Novo equipamento</a> }</div>
<form method="get" class="card mb-3"><div class="card-body"><div class="row g-2"><div class="col-md-5"><input name="pesquisa" value="@ViewData["Pesquisa"]" class="form-control" placeholder="Nome, marca ou número de série" /></div><div class="col-md-3"><select name="categoria" class="form-select"><option value="">Todas as categorias</option>@foreach (var category in ViewData["Categorias"] as string[] ?? Array.Empty<string>()) { <option value="@category" selected="@(Equals(ViewData["Categoria"], category))">@category</option> }</select></div><div class="col-md-2"><select name="estado" class="form-select"><option value="">Todos os estados</option>@foreach (var state in ViewData["Estados"] as string[] ?? Array.Empty<string>()) { <option value="@state" selected="@(Equals(ViewData["Estado"], state))">@state</option> }</select></div><div class="col-md-2"><button class="btn btn-primary w-100">Filtrar</button></div></div></div></form>
<div class="card"><div class="table-responsive"><table class="table table-vcenter card-table"><thead><tr><th>Equipamento</th><th>Categoria</th><th>Número de série</th><th>Cliente</th><th>Estado</th><th></th></tr></thead><tbody>@foreach (var equipment in Model) { <tr><td><strong>@equipment.Nome</strong><div class="text-secondary">@equipment.Marca @equipment.Modelo</div></td><td>@equipment.Categoria</td><td>@equipment.NumeroSerie</td><td>@equipment.Cliente?.NomeCompleto</td><td>@equipment.Estado</td><td class="text-end"><a asp-action="Details" asp-route-id="@equipment.Id" class="btn btn-sm btn-outline-primary" aria-label="Detalhes"><i class="ti ti-eye"></i></a>@if (ViewData["IsCliente"] as bool? != true) { <a asp-action="Edit" asp-route-id="@equipment.Id" class="btn btn-sm btn-outline-secondary" aria-label="Editar"><i class="ti ti-edit"></i></a> }</td></tr> }@if (!Model.Any()) { <tr><td colspan="6" class="text-center text-secondary py-5">Nenhum equipamento encontrado.</td></tr> }</tbody></table></div></div>