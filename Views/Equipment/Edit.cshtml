@* Formulário de edição. A data de registo é enviada oculta para manter o valor atual. *@
@model HelpDeskPro.Models.Equipment
@{ ViewData["Title"] = "Editar equipamento"; ViewData["ActivePage"] = "Equipment"; }
<div class="page-header"><h1 class="page-header-title">Editar equipamento</h1></div><div class="card"><div class="card-body"><form asp-action="Edit" asp-route-id="@Model.Id" method="post"><input type="hidden" asp-for="Id" /><input type="hidden" asp-for="DataRegisto" /><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="Nome" class="form-label"></label><input asp-for="Nome" class="form-control" /><span asp-validation-for="Nome" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Categoria" class="form-label"></label><select asp-for="Categoria" class="form-select">@foreach (var category in ViewData["Categorias"] as string[] ?? Array.Empty<string>()) { <option value="@category">@category</option> }</select></div><div class="col-md-4"><label asp-for="Marca" class="form-label"></label><input asp-for="Marca" class="form-control" /></div><div class="col-md-4"><label asp-for="Modelo" class="form-label"></label><input asp-for="Modelo" class="form-control" /></div><div class="col-md-4"><label asp-for="NumeroSerie" class="form-label"></label><input asp-for="NumeroSerie" class="form-control" /></div><div class="col-md-6"><label asp-for="SistemaOperativo" class="form-label"></label><input asp-for="SistemaOperativo" class="form-control" /></div><div class="col-md-6"><label asp-for="ClienteId" class="form-label">Cliente</label><select asp-for="ClienteId" class="form-select"><option value="">Sem cliente</option>@foreach (var client in ViewData["Clientes"] as List<HelpDeskPro.Models.ApplicationUser> ?? new()) { <option value="@client.Id">@client.NomeCompleto</option> }</select></div><div class="col-md-6"><label asp-for="Estado" class="form-label"></label><select asp-for="Estado" class="form-select">@foreach (var state in ViewData["Estados"] as string[] ?? Array.Empty<string>()) { <option value="@state">@state</option> }</select></div></div><div class="mt-4"><button class="btn btn-primary">Guardar alterações</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></div></form></div></div>