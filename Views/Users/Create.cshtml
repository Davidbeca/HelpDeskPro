@* Formulário administrativo para criar conta, credenciais iniciais e papel de aplicação. *@
@model HelpDeskPro.Models.ApplicationUser
@{ ViewData["Title"] = "Novo utilizador"; ViewData["ActivePage"] = "Users"; }
<div class="page-header"><h1 class="page-header-title">Novo utilizador</h1></div><div class="card"><div class="card-body"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="NomeCompleto" class="form-label">Nome completo</label><input asp-for="NomeCompleto" class="form-control" /><span asp-validation-for="NomeCompleto" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" type="email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div><div class="col-md-6"><label for="password" class="form-label">Palavra-passe inicial</label><input id="password" name="password" type="password" class="form-control" minlength="8" required autocomplete="new-password" /></div><div class="col-md-6"><label asp-for="TipoConta" class="form-label">Tipo de conta</label><select asp-for="TipoConta" class="form-select">@foreach (var type in ViewData["Tipos"] as string[] ?? Array.Empty<string>()) { <option value="@type">@type</option> }</select></div><div class="col-md-4"><label asp-for="ContactoTelefonico" class="form-label">Contacto telefónico</label><input asp-for="ContactoTelefonico" class="form-control" /></div><div class="col-md-4"><label asp-for="Empresa" class="form-label"></label><input asp-for="Empresa" class="form-control" /></div><div class="col-md-4"><label asp-for="Departamento" class="form-label"></label><input asp-for="Departamento" class="form-control" /></div></div><div class="mt-4"><button class="btn btn-primary">Criar utilizador</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></div></form></div></div>