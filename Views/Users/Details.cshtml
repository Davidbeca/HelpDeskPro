@* Perfil do utilizador e histórico dos tickets criados ou atribuídos à respetiva conta. *@
@model HelpDeskPro.Models.ApplicationUser
@{ ViewData["Title"] = "Perfil de utilizador"; ViewData["ActivePage"] = "Users"; }
<div class="page-header d-flex justify-content-between"><div><h1 class="page-header-title">@Model.NomeCompleto</h1><p class="text-secondary">@Model.TipoConta · @(Model.Ativo ? "Ativo" : "Inativo")</p></div><a asp-action="Index" class="btn btn-outline-secondary">Voltar</a></div><div class="card mb-3"><div class="card-body"><dl class="row mb-0"><dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd><dt class="col-sm-3">Contacto</dt><dd class="col-sm-9">@Model.ContactoTelefonico</dd><dt class="col-sm-3">Empresa</dt><dd class="col-sm-9">@Model.Empresa</dd><dt class="col-sm-3">Departamento</dt><dd class="col-sm-9">@Model.Departamento</dd><dt class="col-sm-3">Registado em</dt><dd class="col-sm-9">@Model.DataRegisto.ToString("dd/MM/yyyy")</dd></dl></div></div>
<div class="row row-cards"><div class="col-lg-6"><div class="card"><div class="card-header"><h2 class="card-title">Tickets criados (@Model.TicketsCriados.Count)</h2></div><div class="table-responsive"><table class="table table-vcenter card-table"><tbody>@foreach (var ticket in Model.TicketsCriados.OrderByDescending(t => t.DataCriacao)) { <tr><td>@ticket.NumeroTicket</td><td>@ticket.Titulo</td><td>@ticket.Estado</td><td><a asp-controller="Tickets" asp-action="Details" asp-route-id="@ticket.Id">Abrir</a></td></tr> }@if (Model.TicketsCriados.Count == 0) { <tr><td class="text-secondary">Sem tickets criados.</td></tr> }</tbody></table></div></div></div>@if (Model.TipoConta == "Tecnico") { <div class="col-lg-6"><div class="card"><div class="card-header"><h2 class="card-title">Tickets atribuídos (@Model.TicketsAtribuidos.Count)</h2></div><div class="table-responsive"><table class="table table-vcenter card-table"><tbody>@foreach (var ticket in Model.TicketsAtribuidos.OrderByDescending(t => t.DataCriacao)) { <tr><td>@ticket.NumeroTicket</td><td>@ticket.Titulo</td><td>@ticket.Estado</td><td><a asp-controller="Tickets" asp-action="Details" asp-route-id="@ticket.Id">Abrir</a></td></tr> }@if (Model.TicketsAtribuidos.Count == 0) { <tr><td class="text-secondary">Sem tickets atribuídos.</td></tr> }</tbody></table></div></div></div> }</div>