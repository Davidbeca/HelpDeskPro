@* Formulário de edição. Tag Helpers associam os controlos às propriedades do modelo Ticket. *@
@model HelpDeskPro.Models.Ticket
@{ ViewData["Title"] = "Editar ticket"; ViewData["ActivePage"] = "Tickets"; }
<div class="page-header"><h1 class="page-header-title">Editar @Model.NumeroTicket</h1></div>
<div class="card"><div class="card-body"><form asp-action="Edit" asp-route-id="@Model.Id" method="post"><input type="hidden" asp-for="Id" /><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="row g-3"><div class="col-md-8"><label asp-for="Titulo" class="form-label">Título</label><input asp-for="Titulo" class="form-control" /><span asp-validation-for="Titulo" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Categoria" class="form-label"></label><select asp-for="Categoria" class="form-select">@foreach (var value in ViewData["Categorias"] as string[] ?? Array.Empty<string>()) { <option value="@value">@value</option> }</select></div>
<div class="col-12"><label asp-for="Descricao" class="form-label">Descrição do problema</label><textarea asp-for="Descricao" class="form-control" rows="6"></textarea><span asp-validation-for="Descricao" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="Prioridade" class="form-label"></label><select asp-for="Prioridade" class="form-select">@foreach (var value in ViewData["Prioridades"] as string[] ?? Array.Empty<string>()) { <option value="@value">@value</option> }</select></div><div class="col-md-4"><label asp-for="Estado" class="form-label"></label><select asp-for="Estado" class="form-select">@foreach (var value in ViewData["Estados"] as string[] ?? Array.Empty<string>()) { <option value="@value">@value</option> }</select></div>
<div class="col-md-4"><label asp-for="TecnicoId" class="form-label">Técnico responsável</label><select asp-for="TecnicoId" class="form-select"><option value="">Não atribuído</option>@foreach (var technician in ViewData["Tecnicos"] as List<HelpDeskPro.Models.ApplicationUser> ?? new()) { <option value="@technician.Id">@technician.NomeCompleto (@technician.Email)</option> }</select></div><div class="col-md-6"><label asp-for="PrazoResolucao" class="form-label">Prazo de resolução</label><input asp-for="PrazoResolucao" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" /></div></div>
<div class="mt-4"><button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy"></i> Guardar alterações</button> <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancelar</a></div></form></div></div>