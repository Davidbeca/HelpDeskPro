@* Confirma a remoção de um artigo; apenas administradores podem executar a operação. *@
@model HelpDeskPro.Models.KnowledgeBaseArticle
@{ ViewData["Title"] = "Eliminar artigo"; ViewData["ActivePage"] = "KnowledgeBase"; }
<div class="page-header"><h1 class="page-header-title">Eliminar artigo</h1></div><div class="card"><div class="card-body"><p>Eliminar o artigo <strong>@Model.Titulo</strong>?</p><form asp-action="Delete" asp-route-id="@Model.Id" method="post"><button type="submit" class="btn btn-danger">Eliminar artigo</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></form></div></div>