@* Formulário de criação de artigo; o controlador define autor e data no servidor. *@
@model HelpDeskPro.Models.KnowledgeBaseArticle
@{ ViewData["Title"] = "Novo artigo"; ViewData["ActivePage"] = "KnowledgeBase"; }
<div class="page-header"><h1 class="page-header-title">Novo artigo</h1></div><div class="card"><div class="card-body"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="Titulo" class="form-label"></label><input asp-for="Titulo" class="form-control" /><span asp-validation-for="Titulo" class="text-danger"></span></div><div class="mb-3"><label asp-for="Categoria" class="form-label"></label><select asp-for="Categoria" class="form-select">@foreach (var category in ViewData["Categorias"] as string[] ?? Array.Empty<string>()) { <option value="@category">@category</option> }</select></div><div class="mb-3"><label asp-for="Conteudo" class="form-label">Conteúdo</label><textarea asp-for="Conteudo" class="form-control" rows="12"></textarea><span asp-validation-for="Conteudo" class="text-danger"></span></div><div class="form-check mb-3"><input asp-for="Publicado" class="form-check-input" /><label asp-for="Publicado" class="form-check-label">Publicado</label></div><button class="btn btn-primary">Criar artigo</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></form></div></div>