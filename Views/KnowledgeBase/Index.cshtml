@* Pesquisa de soluções; artigos publicados são públicos para contas autenticadas e rascunhos só para a equipa. *@
@model IEnumerable<HelpDeskPro.Models.KnowledgeBaseArticle>
@{ ViewData["Title"] = "Base de conhecimento"; ViewData["ActivePage"] = "KnowledgeBase"; }
<div class="page-header d-flex justify-content-between align-items-center"><div><h1 class="page-header-title">Base de conhecimento</h1><p class="text-secondary">Soluções técnicas e procedimentos de suporte</p></div>@if (ViewData["CanManage"] as bool? == true) { <a asp-action="Create" class="btn btn-primary"><i class="ti ti-plus"></i> Novo artigo</a> }</div>
<form method="get" class="card mb-3"><div class="card-body"><div class="row g-2"><div class="col-md-7"><input name="pesquisa" value="@ViewData["Pesquisa"]" class="form-control" placeholder="Pesquisar artigos e soluções" /></div><div class="col-md-3"><select name="categoria" class="form-select"><option value="">Todas as categorias</option>@foreach (var category in ViewData["Categorias"] as string[] ?? Array.Empty<string>()) { <option value="@category" selected="@(Equals(ViewData["Categoria"], category))">@category</option> }</select></div><div class="col-md-2"><button class="btn btn-primary w-100">Pesquisar</button></div></div></div></form>
<div class="row row-cards">@foreach (var article in Model) { <div class="col-md-6"><article class="card h-100"><div class="card-body"><div class="d-flex justify-content-between"><span class="badge bg-blue-lt">@article.Categoria</span>@if (!article.Publicado) { <span class="badge bg-orange-lt">Rascunho</span> }</div><h2 class="h3 mt-3"><a asp-action="Details" asp-route-id="@article.Id" class="text-reset">@article.Titulo</a></h2><p class="text-secondary">@(article.Conteudo.Length > 220 ? article.Conteudo[..220] + "…" : article.Conteudo)</p><div class="small text-secondary">@article.Autor?.NomeCompleto · @article.DataCriacao.ToString("dd/MM/yyyy") · @article.Visualizacoes visualizações</div></div><div class="card-footer d-flex gap-2"><a asp-action="Details" asp-route-id="@article.Id" class="btn btn-sm btn-outline-primary">Ler artigo</a>@if (ViewData["CanManage"] as bool? == true) { <a asp-action="Edit" asp-route-id="@article.Id" class="btn btn-sm btn-outline-secondary">Editar</a> }</div></article></div> }@if (!Model.Any()) { <div class="col-12"><div class="card"><div class="card-body text-center text-secondary">Não foram encontrados artigos.</div></div></div> }</div>