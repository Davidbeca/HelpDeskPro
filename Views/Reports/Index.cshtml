@* Relatórios: cartões e gráficos são preenchidos com agregações calculadas no ReportsController. *@
@using System.Text.Json
@{
    ViewData["Title"] = "Relatórios"; ViewData["ActivePage"] = "Reports";
    var periodJson = JsonSerializer.Serialize(ViewData["TicketsPorPeriodo"], new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
    var priorityJson = JsonSerializer.Serialize(ViewData["TicketsPorPrioridade"], new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
}
<div class="page-header d-flex justify-content-between align-items-center"><div><h1 class="page-header-title">Relatórios</h1><p class="text-secondary">Indicadores de suporte no período selecionado</p></div><button type="button" class="btn btn-outline-primary" onclick="window.print()"><i class="ti ti-file-type-pdf"></i> Exportar / imprimir PDF</button></div>
<form method="get" class="mb-3"><div class="input-group"><select name="periodo" class="form-select"><option value="semana" selected="@(Equals(ViewData["Periodo"], "semana"))">Últimos 7 dias</option><option value="mes" selected="@(Equals(ViewData["Periodo"], "mes"))">Último mês</option><option value="trimestre" selected="@(Equals(ViewData["Periodo"], "trimestre"))">Último trimestre</option><option value="ano" selected="@(Equals(ViewData["Periodo"], "ano"))">Último ano</option></select><button class="btn btn-primary">Aplicar período</button></div></form>
<div class="row row-cards mb-3"><div class="col-sm-6 col-lg-3"><div class="card"><div class="card-body"><div class="text-secondary">Tickets criados</div><div class="h1 mb-0">@ViewData["TotalTickets"]</div></div></div></div><div class="col-sm-6 col-lg-3"><div class="card"><div class="card-body"><div class="text-secondary">Resolvidos / fechados</div><div class="h1 mb-0 text-success">@ViewData["TicketsResolvidos"]</div></div></div></div><div class="col-sm-6 col-lg-3"><div class="card"><div class="card-body"><div class="text-secondary">A aguardar resposta</div><div class="h1 mb-0 text-warning">@ViewData["TicketsPendentes"]</div></div></div></div><div class="col-sm-6 col-lg-3"><div class="card"><div class="card-body"><div class="text-secondary">Tempo médio de resolução</div><div class="h1 mb-0">@(((double?)ViewData["TempoMedioResolucao"] ?? 0).ToString("0.0")) h</div></div></div></div></div>
<div class="row row-cards"><div class="col-lg-8"><div class="card"><div class="card-header"><h2 class="card-title">Tickets criados por dia</h2></div><div class="card-body"><canvas id="periodChart" height="100"></canvas></div></div></div><div class="col-lg-4"><div class="card"><div class="card-header"><h2 class="card-title">Por prioridade</h2></div><div class="card-body"><canvas id="priorityChart" height="220"></canvas></div></div></div><div class="col-12"><div class="card"><div class="card-header"><h2 class="card-title">Tickets por técnico</h2></div><div class="table-responsive"><table class="table table-vcenter card-table"><thead><tr><th>Técnico</th><th>Tickets</th></tr></thead><tbody>@foreach (var item in ViewData["TicketsPorTecnico"] as IEnumerable<dynamic> ?? Array.Empty<dynamic>()) { <tr><td>@item.Tecnico</td><td>@item.Count</td></tr> }</tbody></table></div></div></div></div>
@section Scripts { @* Os dados serializados pelo servidor alimentam os gráficos do período selecionado. *@ <script src="https://cdn.jsdelivr.net/npm/chart.js"></script><script>
const periodData = @Html.Raw(periodJson); const priorityData = @Html.Raw(priorityJson);
new Chart(document.getElementById('periodChart'), { type: 'line', data: { labels: periodData.map(x => new Date(x.data).toLocaleDateString()), datasets: [{ label: 'Tickets', data: periodData.map(x => x.count), borderColor: '#1677ff', backgroundColor: 'rgba(22,119,255,.12)', fill: true, tension: .25 }] }, options: { responsive: true, plugins: { legend: { display: false } } } });
new Chart(document.getElementById('priorityChart'), { type: 'doughnut', data: { labels: priorityData.map(x => x.prioridade), datasets: [{ data: priorityData.map(x => x.count), backgroundColor: ['#38a169','#1677ff','#ed8936','#e53e3e'] }] }, options: { responsive: true } });
</script> }